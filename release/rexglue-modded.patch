diff --git a/include/rex/graphics/shader_worker_budget.h b/include/rex/graphics/shader_worker_budget.h
new file mode 100644
index 0000000..f0ebe44
--- /dev/null
+++ b/include/rex/graphics/shader_worker_budget.h
@@ -0,0 +1,16 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+
+namespace rex::graphics {
+// Leave capacity for emulated CPUs, streaming, audio and presentation. Unknown
+// topology is deliberately conservative; a single-core host still needs a
+// worker to make progress without turning asynchronous compilation off.
+constexpr size_t ShaderWorkerBudget(size_t logical_processors, int requested = -1) {
+  const size_t automatic = std::clamp(logical_processors / 4, size_t(1), size_t(4));
+  if (requested < 0) return automatic;
+  if (requested == 0) return 0;
+  return std::min(size_t(requested), std::max(logical_processors, size_t(1)));
+}
+}  // namespace rex::graphics
diff --git a/include/rex/graphics/shadow_lift.h b/include/rex/graphics/shadow_lift.h
new file mode 100644
index 0000000..6543d67
--- /dev/null
+++ b/include/rex/graphics/shadow_lift.h
@@ -0,0 +1,17 @@
+#pragma once
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace rex::graphics {
+// A small exposure-like lift confined to shadows. Endpoints remain unchanged,
+// unlike an additive brightness offset. Monotonic for strength in [0, 0.5].
+inline uint32_t LiftShadowSample(uint32_t value, uint32_t maximum, double strength) {
+  value = std::min(value, maximum);
+  if (!std::isfinite(strength) || strength <= 0.0) return value;
+  const double x = double(value) / maximum;
+  const double inverse = 1.0 - x;
+  const double result = x + std::min(strength, 0.5) * x * inverse * inverse * inverse;
+  return uint32_t(std::clamp(result * maximum + 0.5, 0.0, double(maximum)));
+}
+} // namespace rex::graphics
