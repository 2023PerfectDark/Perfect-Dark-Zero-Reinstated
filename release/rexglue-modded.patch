+const reg::DC_LUT_30_COLOR* CommandProcessor::gamma_ramp_256_entry_table() const {
+  const double strength = REXCVAR_GET(pdz_shadow_lift);
+  if (!(strength > 0.0)) return gamma_ramp_256_entry_table_;
+  for (size_t i = 0; i < 256; ++i) {
+    auto value = gamma_ramp_256_entry_table_[i];
+    value.color_10_red = LiftShadowSample(value.color_10_red, 1023, strength);
+    value.color_10_green = LiftShadowSample(value.color_10_green, 1023, strength);
+    value.color_10_blue = LiftShadowSample(value.color_10_blue, 1023, strength);
+    lifted_gamma_table_[i] = value;
+  }
+  return lifted_gamma_table_;
+}
+
+const reg::DC_LUT_PWL_DATA* CommandProcessor::gamma_ramp_pwl_rgb() const {
+  const double strength = REXCVAR_GET(pdz_shadow_lift);
+  if (!(strength > 0.0)) return gamma_ramp_pwl_rgb_[0];
+  for (size_t i = 0; i < 128; ++i) for (size_t channel = 0; channel < 3; ++channel) {
+    auto value = gamma_ramp_pwl_rgb_[i][channel];
+    const uint32_t start = LiftShadowSample(value.base, 65535, strength);
+    const uint32_t end = LiftShadowSample(uint32_t(value.base) + value.delta, 65535, strength);
+    value.base = start;
+    value.delta = end - start;
+    lifted_gamma_pwl_[i * 3 + channel] = value;
+  }
+  return lifted_gamma_pwl_;
+}
+
