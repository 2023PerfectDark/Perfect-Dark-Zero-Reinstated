@@ -48,6 +48,13 @@ struct FPSCRPlatform {
   static inline void InitHostExceptions(u32& csr) noexcept {
     csr |= ExceptionMask;  // Set mask bits to disable exceptions
   }
+
+  // Forces host FP exceptions masked regardless of csr's prior state. Needed
+  // because callers like enableFlushModeUnconditional/storeFromGuest write a
+  // csr value that may have gone stale/lost its exception-mask bits (e.g. a
+  // fresh CallFrame copy) - blindly setcsr()'ing that would unmask host FP
+  // exceptions and turn a routine inexact/denormal result into a hard trap.
+  static constexpr u32 DisableExceptions(u32 csr) noexcept { return csr | ExceptionMask; }
 };
 
 #elif defined(__aarch64__) || defined(_M_ARM64)
@@ -80,6 +87,10 @@ struct FPSCRPlatform {
   static inline void InitHostExceptions(u32& csr) noexcept {
     csr &= ~ExceptionMask;  // Clear enable bits to disable exceptions
   }
+
+  // See x86_64 DisableExceptions above - same purpose, inverted polarity
+  // (ARM: 1 = exception enabled, so it must be cleared instead of set).
+  static constexpr u32 DisableExceptions(u32 csr) noexcept { return csr & ~ExceptionMask; }
 };
 
