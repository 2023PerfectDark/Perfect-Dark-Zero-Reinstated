+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_BOOL(win32_mmcss, true, "Win32",
+                    "Opts in to the Multimedia Class Scheduler Service (MMCSS) for prioritized "
+                    "access to CPU resources")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
