+void D3D12CommandProcessor::ApplyDrawResolutionScaleRequest() {
+  uint32_t requested_scale_x, requested_scale_y;
+  bool force_rebuild;
+  if (!TakeDrawResolutionScaleRequest(requested_scale_x, requested_scale_y, force_rebuild)) {
+    return;
+  }
+  const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+  // Scaled resolves need tiled resources and enough virtual address bits.
+  if (!TextureCache::ClampDrawResolutionScaleToMaxSupported(
+          requested_scale_x, requested_scale_y,
+          provider.GetTiledResourcesTier() >= D3D12_TILED_RESOURCES_TIER_1,
+          provider.GetVirtualAddressBitsPerResource())) {
+    REXGPU_WARN(
+        "The requested draw resolution scale is not supported by the device, reducing to {}x{}",
+        requested_scale_x, requested_scale_y);
+  }
+  uint32_t old_scale_x = texture_cache_->draw_resolution_scale_x();
+  uint32_t old_scale_y = texture_cache_->draw_resolution_scale_y();
+  if (!force_rebuild && requested_scale_x == old_scale_x && requested_scale_y == old_scale_y) {
+    return;
+  }
+  // Pipelines still being created would be dropped with their threads: try
+  // again at the end of a later frame.
+  if (pipeline_cache_->IsCreatingPipelines()) {
+    RequestDrawResolutionScale(requested_scale_x, requested_scale_y, force_rebuild);
+    return;
+  }
+  // The objects being destroyed may still be used by the GPU.
+  if (!AwaitAllQueueOperationsCompletion()) {
+    if (!device_removed_) {
+      RequestDrawResolutionScale(requested_scale_x, requested_scale_y, force_rebuild);
+    }
+    return;
+  }
+
+  const auto old_path = render_target_cache_->GetPath();
+  auto render_target_path = RenderTargetCache::Path::kHostRenderTargets;
+  const auto configured_path = REXCVAR_GET(render_target_path_d3d12);
+  if (configured_path == "rov" ||
+      (configured_path != "rtv" && configured_path != "rov" &&
+       provider.GetAdapterVendorID() == ui::GraphicsProvider::GpuVendorID::kIntel &&
+       !provider.IsIntelArcGpu()))
+    render_target_path = RenderTargetCache::Path::kPixelShaderInterlock;
+  if (!provider.AreRasterizerOrderedViewsSupported())
+    render_target_path = RenderTargetCache::Path::kHostRenderTargets;
+  const bool path_changed = old_path != render_target_path;
+  if (path_changed) pipeline_cache_->ShutdownShaderStorage();
+
+  // Destroy everything that has the old scale baked in before creating anything
+  // for the new one, not to need memory for both at once.
+  pipeline_cache_->DestroyDrawResolutionScaleDependentObjects();
+  texture_cache_->InvalidateScaledResolveRangesInSharedMemory();
+  texture_cache_.reset();
+  render_target_cache_->Shutdown();
+
+  // Recreate for the new scale, or for 1x if that fails (not enough memory).
+  uint32_t new_scale_x = requested_scale_x;
+  uint32_t new_scale_y = requested_scale_y;
+  bool caches_created =
+      CreateDrawResolutionScaleDependentCaches(new_scale_x, new_scale_y, render_target_path);
+  if (!caches_created && (new_scale_x > 1 || new_scale_y > 1)) {
+    new_scale_x = 1;
+    new_scale_y = 1;
+    caches_created =
+        CreateDrawResolutionScaleDependentCaches(new_scale_x, new_scale_y, render_target_path);
+  }
+  if (!caches_created) {
+    // This has also succeeded at startup, though.
+    rex::FatalError("Failed to recreate the GPU emulation state for a draw resolution scale");
+  }
+  if (path_changed) {
+    // GPU work and translation threads are drained. No pipeline can still
+    // refer to a root signature from the previous render-target path.
+    ui::d3d12::util::ReleaseAndNull(root_signature_bindless_ds_);
+    ui::d3d12::util::ReleaseAndNull(root_signature_bindless_vs_);
+    for (auto& entry : root_signatures_bindful_) entry.second->Release();
+    root_signatures_bindful_.clear();
+    zpd_hybrid_supported_ = REXCVAR_GET(occlusion_query_full_counters) && command_list_2_ &&
+        render_target_path == RenderTargetCache::Path::kHostRenderTargets;
+    pipeline_cache_->SetHybridSupported(zpd_hybrid_supported_);
+    xenos_sample_positions_used_ = command_list_1_ &&
+        provider.GetProgrammableSamplePositionsTier() != D3D12_PROGRAMMABLE_SAMPLE_POSITIONS_TIER_NOT_SUPPORTED &&
+        (render_target_path == RenderTargetCache::Path::kPixelShaderInterlock || REXCVAR_GET(xenos_sample_positions));
+    if (!CreateGuestRootSignatures())
+      rex::FatalError("Failed to recreate graphics bindings for the render-target mode");
+  }
+  pipeline_cache_->CreateDrawResolutionScaleDependentObjects();
+
+  if (path_changed && live_cache_title_) {
+    pipeline_cache_->InitializeShaderStorage(live_cache_root_, live_cache_title_, false);
+    REXGPU_INFO("GPU: render target mode changed live to {}",
+        render_target_path == RenderTargetCache::Path::kHostRenderTargets ? "RTV" : "ROV");
+  }
+
+  // The bindless descriptors of the EDRAM buffer, which has been recreated.
+  // With bindful descriptors, they're written when needed.
+  if (bindless_resources_used_) {
+    WriteEdramBindlessDescriptors();
   }
 
+  // Occlusion query sample counts are normalized by the scale.
+  zpd_draw_resolution_scale_x_ = new_scale_x;
+  zpd_draw_resolution_scale_y_ = new_scale_y;
+
+  // Drop the state referring to the destroyed objects (most of the rest is
+  // reset when the next submission and frame begin).
+  current_guest_pipeline_ = nullptr;
+  current_external_pipeline_ = nullptr;
+  current_graphics_root_signature_ = nullptr;
+  // Only used for downscaling scaled resolves for readback, recreated when
+  // needed; the readback buffers themselves hold unscaled data and are kept.
+  if (new_scale_x <= 1 && new_scale_y <= 1) {
+    resolve_downscale_buffer_size_ = 0;
+    resolve_downscale_buffer_.Reset();
+  }
+
+  if (new_scale_x != requested_scale_x || new_scale_y != requested_scale_y) {
+    REXGPU_WARN(
+        "GPU: draw resolution scale changed to {}x{} - failed to set up {}x{} (not enough GPU "
+        "memory?)",
+        new_scale_x, new_scale_y, requested_scale_x, requested_scale_y);
+  } else {
+    REXGPU_INFO("GPU: draw resolution scale changed to {}x{}", new_scale_x, new_scale_y);
+  }
+}
