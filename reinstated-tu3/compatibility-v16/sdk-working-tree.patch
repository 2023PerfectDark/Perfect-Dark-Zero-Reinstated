+    if (i == block_last && (page_last & 63) != 63) {
+      gpu_written_bits &= (uint64_t(1) << ((page_last & 63) + 1)) - 1;
+    }
+    if (gpu_written_bits) {
+      return true;
+    }
+  }
+  return false;
+}
