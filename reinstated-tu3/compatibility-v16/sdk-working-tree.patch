 [[noreturn]] inline void ppc_longjmp(u32 guest_buf_addr, int val) {
   auto& map = get_jmp_buf_map();
   auto it = map.find(guest_buf_addr);
   if (it != map.end()) {
-    longjmp(it->second, val);
+    longjmp(it->second.buf, val);
