# Compile a derived TU0 translation unit without changing codegen output.
file(READ "${INPUT_FILE}" code)
string(FIND "${code}" "DEFINE_REX_FUNC(sub_82217AD8)" position)
if(position EQUAL -1)
  message(FATAL_ERROR "Native cutscene update moved; review TU0 source selection")
endif()
string(FIND "${code}" "pdz_cutscene::AheadFallback" patched)
if(patched EQUAL -1)
  set(old "ctx.f31.f64 = double(temp.f32);\nloc_82217B9C:")
  string(FIND "${code}" "${old}" anchor)
  if(anchor EQUAL -1)
    message(FATAL_ERROR "Cutscene timing TU0 anchor missing")
  endif()
  string(REPLACE "${old}" "ctx.f31.f64 = pdz_cutscene::AheadFallback(double(temp.f32));\nloc_82217B9C:" code "${code}")
  set(code "#include \"cutscene_timing.h\"\n${code}")
endif()
file(WRITE "${OUTPUT_FILE}" "${code}")
