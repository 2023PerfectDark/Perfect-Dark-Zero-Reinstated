# Derived TU0 sources: widen only the capacity loads immediately following
# GetAmmoDefinition, leaving the original generated files and assets intact.
file(READ "${INPUT_FILE}" code)
set(pattern "sub_824E80B0\\(ctx, base\\);[^;]*;[^;]*;[^;]*REX_LOAD_U8\\(ctx\\.r3\\.u32 \\+ 0\\);")
string(REGEX MATCHALL "${pattern}" matches "${code}")
list(LENGTH matches count)
# MATCHALL treats C++ semicolons as CMake list separators; count via a loop
# over matches removed from a scratch copy instead.
set(count 0)
set(remaining "${code}")
while(TRUE)
  string(REGEX MATCH "${pattern}" match "${remaining}")
  if(match STREQUAL "")
    break()
  endif()
  math(EXPR count "${count} + 1")
  string(REPLACE "REX_LOAD_U8(ctx.r3.u32 + 0)" "pdz_weapons::ReserveLimit(base, ctx.r3.u32)" replacement "${match}")
  string(REPLACE "${match}" "${replacement}" code "${code}")
  string(REPLACE "${match}" "" remaining "${remaining}")
endwhile()
if(NOT count EQUAL EXPECTED_CAPS)
  message(FATAL_ERROR "TU0 ammo capacity anchors changed: expected ${EXPECTED_CAPS}, found ${count} in ${INPUT_FILE}")
endif()
if(TU_INDEX EQUAL 184)
  set(old "ctx.lr = 0x8225B2C8;\n\tREX_CALL_INDIRECT_FUNC(ctx.ctr.u32);\n\t// mr r30,r3\n\tctx.r30.u64 = ctx.r3.u64;")
  string(FIND "${code}" "${old}" anchor)
  if(anchor EQUAL -1)
    message(FATAL_ERROR "TU0 secondary ammo HUD anchor changed")
  endif()
  set(new "ctx.lr = 0x8225B2C8;\n\tREX_CALL_INDIRECT_FUNC(ctx.ctr.u32);\n\t// Use the native continuous gauge for oversized Classic reserves.\n\tctx.r30.u64 = pdz_weapons::SecondaryHudSlots(base, ctx.r3.u32);")
  string(REPLACE "${old}" "${new}" code "${code}")
endif()
if(TU_INDEX EQUAL 99)
  # Crash dump 40872: 82561B58 calls the weapon-type query with r3=0.
  # Finish this callback through its normal epilogue when the selected slot
  # is empty. Guarding only the callee would leave two more null reads below.
  set(old "ctx.lr = 0x82561B58;\n\tsub_825D6D60(ctx, base);")
  string(FIND "${code}" "${old}" anchor)
  if(anchor EQUAL -1)
    message(FATAL_ERROR "TU0 empty weapon slot crash anchor changed")
  endif()
  string(REPLACE "${old}" "if (!ctx.r3.u32) goto loc_82561BF4;\n\t${old}" code "${code}")
endif()
if(PATCH_SPREAD)
  set(old "// fadds f31,f0,f2\n\tctx.fpscr.disableFlushMode();\n\tctx.f31.f64 = double(float(ctx.f0.f64 + ctx.f2.f64));")
  string(FIND "${code}" "${old}" anchor)
  if(anchor EQUAL -1)
    message(FATAL_ERROR "TU0 bullet spread anchor changed")
  endif()
  string(REPLACE "${old}" "// Local-player aiming cone: base weapon spread plus firing bloom.\n\tctx.fpscr.disableFlushMode();\n\tctx.f31.f64 = pdz_weapons::Spread(base, ctx.r31.u32, double(float(ctx.f0.f64 + ctx.f2.f64)));" code "${code}")
endif()
file(WRITE "${OUTPUT_FILE}" "#include \"weapon_rules.h\"\n${code}")
